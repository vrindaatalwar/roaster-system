server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Railway service IPs can change after a deployment. Resolve the private
    # hostname at request time and use IPv4 to match the API's 0.0.0.0 bind.
    resolver [fd12::10] valid=5s ipv6=off;
    set $api_upstream "${API_UPSTREAM}";
    set $api_health_upstream "${API_UPSTREAM}/health";

    location /api/ {
        proxy_pass $api_upstream;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass $api_health_upstream;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
